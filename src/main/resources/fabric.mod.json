{
  "schemaVersion": 1,
  "id": "createlapissheet",
  "version": "${version}",
  "name": "Create: Lapis Sheet",
  "description": "Lapis sheet was reborn!",
  "authors": [
    "557"
  ],
  "contact": {
    "sources": "https://github.com/KKW557/createlapissheet",
    "issues": "https://github.com/KKW557/createlapissheet/issues"
  },
  "license": "MIT",
  "icon": "assets/createlapissheet/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.Main"
      }
    ],
    "create_plugin": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.Main"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.client.Client"
      }
    ],
    "jei_mod_plugin": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.client.compat.JeiModPlugin"
      }
    ],
    "rei_common": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.compat.ReiCommon"
      }
    ],
    "rei_client": [
      {
        "adapter": "kotlin",
        "value": "icu.suc.createlapissheet.client.compat.ReiClient"
      }
    ]
  },
  "accessWidener": "createlapissheet.accesswidener",
  "mixins": [
    "createlapissheet.mixins.json",
    {
      "config": "createlapissheet.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-language-kotlin": ">=${kotlin}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "create": "*"
  }
}
